{
    "name": "pushinbr/pam-native-testing",
    "description": "Deterministic bridge fakes and assertions for PAM Native applications and plugins.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "pushinbr/pam-native":"^0.8.0"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Native\\Testing\\": "src/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --level=9 --no-progress",
        "test": "php tests/run.php",
        "verify": ["@analyse", "@test"]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
