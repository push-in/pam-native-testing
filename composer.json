{
    "name": "pushinbr/pam-native-testing",
    "description": "Deterministic bridge fakes and assertions for PAM Native applications and plugins.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "pushinbr/pam-native":"^0.8 || ^0.9 || ^0.10 || ^1.0"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Native\\Testing\\": "src/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
